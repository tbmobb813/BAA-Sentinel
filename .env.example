# Postgres connection string (Prisma). Any Postgres works, including a
# Supabase-hosted instance -- Supabase is used for Storage only in this
# stack now, not Auth or querying.
DATABASE_URL="postgresql://user:password@localhost:5432/baa_sentinel"

# Clerk (Dashboard -> API Keys). Enable Organizations in the Clerk
# dashboard -- the schema assumes every user belongs to at least one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Dashboard -> Webhooks -> your endpoint).
# Only needed once you have a publicly reachable URL to register --
# src/lib/data/org.ts lazily syncs Clerk -> Postgres without it, which is
# what local dev relies on.
CLERK_WEBHOOK_SIGNING_SECRET=

# Public app URL (used to build vendor-facing verification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email for verification requests + reminders)
# Optional in dev -- omitted, sends log to the console instead of an email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BAA Sentinel <onboarding@resend.dev>"

# Stripe (subscription billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID=
NEXT_PUBLIC_STRIPE_MSP_PRICE_ID=

# Anthropic (AI risk scoring, Growth/MSP tiers)
# Optional in dev -- risk scoring is skipped when unset.
ANTHROPIC_API_KEY=

# Reminder cascade cron (src/app/api/cron/reminders/route.ts). Vercel Cron
# sends this automatically as an Authorization: Bearer header in
# production; set it locally too if you want to hit the route by hand.
CRON_SECRET=

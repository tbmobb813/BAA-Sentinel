# Postgres connection string (Prisma). Any Postgres works, including a
# Supabase-hosted instance -- Supabase has no other role in this stack
# (Auth is Clerk, file storage is Vercel Blob).
DATABASE_URL="postgresql://user:password@localhost:5432/baa_sentinel"

# Clerk (Dashboard -> API Keys). Enable Organizations in the Clerk
# dashboard -- the schema assumes every user belongs to at least one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Dashboard -> Webhooks -> your endpoint).
# Only needed once you have a publicly reachable URL to register --
# src/lib/data/org.ts lazily syncs Clerk -> Postgres without it, which is
# what local dev relies on.
CLERK_WEBHOOK_SIGNING_SECRET=

# Public app URL (used to build vendor-facing verification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email for verification requests + reminders)
# Optional in dev -- omitted, sends log to the console instead of an email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BAA Sentinel <onboarding@resend.dev>"

# Stripe (subscription billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID=
NEXT_PUBLIC_STRIPE_MSP_PRICE_ID=

# Anthropic (AI risk scoring, Growth/MSP tiers)
# Optional in dev -- risk scoring is skipped when unset.
ANTHROPIC_API_KEY=

# Trigger.dev (primary reminder cascade, src/trigger/reminders.ts)
# TRIGGER_PROJECT_REF goes in trigger.config.ts's `project` field (not a
# secret, safe to hardcode there instead if you prefer). TRIGGER_SECRET_KEY
# authenticates `npx trigger.dev dev`/`deploy` -- get both from your
# project's dashboard after creating a free account.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Vercel Cron (backup reminder cascade, src/app/api/cron/reminders/route.ts)
# Not needed locally -- only real when deployed to Vercel, which sets this
# automatically once a CRON_SECRET env var exists in the project (Settings
# -> Environment Variables). Generate any random string of 16+ characters.
CRON_SECRET=

# Vercel Blob (vendor document upload). Auto-populated by Vercel once a
# Blob store is connected to the project (Storage tab -> Create Database
# -> Blob); for local dev, copy the token from that same dashboard page.
BLOB_READ_WRITE_TOKEN=
